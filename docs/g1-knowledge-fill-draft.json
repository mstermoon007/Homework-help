  "items": [
    {
      "id": "math-g1-m0-make-ten",
      "name": "凑十法",
      "patch": {
        "concept": "进位加法策略：把一个加数拆分，使其与另一个加数凑成 10，再用 10 加剩余部分（如 9+5=9+1+4=14）。",
        "operations": [
          "add",
          "decompose"
        ],
        "factualContent": {
          "rule": "拆小数凑十：9+x 把 x 拆成 1 和(x-1)，8+x 拆成 2 和(x-2)；十的组成 1+9、2+8、3+7、4+6、5+5"
        },
        "common_errors": [
          {
            "id": "split-error",
            "category": "calculation",
            "description": "加数拆分错误，凑不成 10"
          },
          {
            "id": "remnant-omission",
            "category": "calculation",
            "description": "凑成 10 后遗漏加剩余部分"
          }
        ],
        "graphicType": "diagram",
        "applicable_question_types": [
          {
            "type": "calc",
            "coefficient": 1
          },
          {
            "type": "fill",
            "coefficient": 0.6
          }
        ],
        "prerequisites": []
      }
    },
    {
      "id": "math-g1-m0-make-ten-ping",
      "name": "平十法",
      "patch": {
        "concept": "退位减法策略：把减数拆成两部分，先用被减数减去与个位相同的部分得整十，再减剩余部分（如 15-8=15-5-3=7）。",
        "operations": [
          "subtract",
          "decompose"
        ],
        "factualContent": {
          "rule": "平十法：15-8 把 8 拆成 5 和 3，15-5=10，10-3=7；先减个位凑整十"
        },
        "common_errors": [
          {
            "id": "split-error",
            "category": "calculation",
            "description": "减数拆分未先取个位，凑不成整十"
          },
          {
            "id": "borrow-omission",
            "category": "calculation",
            "description": "连续减时漏减剩余部分"
          }
        ],
        "graphicType": "diagram",
        "applicable_question_types": [
          {
            "type": "calc",
            "coefficient": 1
          },
          {
            "type": "fill",
            "coefficient": 0.6
          }
        ],
        "prerequisites": [
          "math-g1-m0-make-ten"
        ]
      }
    },
    {
      "id": "math-g1-m0-make-ten-po",
      "name": "破十法",
      "patch": {
        "concept": "退位减法策略：把被减数拆成 10 和几，先用 10 减减数，再加剩余部分（如 13-5=10-5+3=8）。",
        "operations": [
          "subtract",
          "decompose"
        ],
        "factualContent": {
          "rule": "破十法：13-5 → 13 拆成 10 和 3，10-5=5，5+3=8"
        },
        "common_errors": [
          {
            "id": "split-error",
            "category": "calculation",
            "description": "被减数拆分错误"
          },
          {
            "id": "remnant-omission",
            "category": "calculation",
            "description": "10 减减数后遗漏加剩余部分"
          }
        ],
        "graphicType": "diagram",
        "applicable_question_types": [
