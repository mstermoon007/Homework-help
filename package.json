    "build:presentation": "node dev/build-presentation-bundle.js",
    "verify:presentation-runtime": "node dev/check-presentation-runtime.js",
    "verify:m3": "node --test tests/strategy/*.test.js && node dev/check-strategy-config.js && node dev/build-strategy-bundle.js && node dev/check-strategy-plumbing.js",
    "verify:m4": "node --test tests/generator/*.test.js && node dev/check-generator-contract.js && node dev/check-generator-adapter.js && node dev/check-generator-registry.js && node dev/check-generator-inventory.js && node dev/check-generator-clusters.js && node dev/check-core-generators.js && node dev/check-generator-mode.js && node dev/check-generator-migration.js math-oral && node dev/check-generator-migration-switch.js && node dev/check-generator-migration-r18.js && node dev/check-strategy-bundle.js && node dev/check-comprehensive-pipeline.js && node dev/check-plugin-responsibility.js && node dev/check-migration-status.js",
    "test:equivalence": "node dev/test-generator-equivalence.js",
    "test:regression": "node dev/test-generator-regression.js",
    "verify-pages": "node dev/verify-pages.js",
    "check-knowledge": "node dev/verify-knowledge-bank.js",
    "check-regression": "node dev/regression-check.js",
    "check-duplicates": "node dev/check-duplicates.js",
    "check-fingerprint": "node dev/plugin-fingerprint.js",
    "check:sw-version": "node scripts/sync-sw-version.js",
    "check:registry": "node scripts/verify-registry.js",
    "check:contrast": "node dev/check-contrast.js",
    "test": "npm run check:sw-version && npm run check:registry && npm run check:contrast && npm run verify:setup && npm run check-knowledge && npm run check-regression && node dev/test-difficulty.js && node dev/test-difficulty-static.js && node dev/verify-svg.js && npm run verify:difficulty-anchor && npm run check-lint",
    "check-lint": "node dev/lint-check.js",
    "check-language": "node dev/verify-language-banks.js",
    "check-plugin-interfaces": "node dev/check-plugin-interfaces.js",
    "verify:ui-boundary": "node dev/check-ui-boundary.js",
    "verify:practice-page": "node dev/check-practice-page.js",
    "verify:frozen-core": "node dev/check-frozen-core.js --check",
    "verify:p4-legacy-gate": "node dev/check-p4-legacy-gate.js",
    "test:plugins": "node --test test/plugins/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:node": "node --test test/*.test.js test/plugins/*.test.js test/unit/*.test.js",
    "generate:knowledge": "node scripts/generate-knowledge-pages.js --incremental",
    "watch:knowledge": "node scripts/generate-knowledge-pages.js --watch",
    "check-contracts": "node dev/check-generator-contract.js",
    "verify:difficulty-anchor": "node dev/check-difficulty-anchor.js"
