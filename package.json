    "verify:kb": "node dev/check-knowledge-contract.js",
    "verify:plugin": "node dev/check-plugin-contract.js",
    "verify:difficulty": "node dev/check-difficulty-dual.js",
    "verify:golden": "node dev/check-golden.js",
    "verify:snapshot": "node dev/check-snapshot.js",
    "verify:rules": "node dev/check-architecture-rules.js",
    "verify:layers": "node dev/check-architecture-layers.js",
    "verify:m1:ontology": "node dev/check-ontology-schema.js",
    "verify:m1:operation": "node dev/check-operation-ontology.js",
    "verify:m1:factual": "node dev/check-factual-content.js",
