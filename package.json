{
  "name": "homework-help",
  "version": "4.3.0",
  "private": true,
  "description": "小学练习本（Homework Help）— 免费无广告的小学 1-6 年级练习题生成与打印工具",
  "scripts": {
    "verify": "node dev/verify-m0.js",
    "verify:kb-dir": "node dev/check-knowledge-dir.js",
    "verify:syntax": "node dev/check-syntax.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:sw-version": "node scripts/sync-sw-version.js",
    "check-lint": "node dev/lint-check.js",
    "build:strategy": "node dev/build-strategy-bundle.js",
    "build:presentation": "node dev/build-presentation-bundle.js",
    "build:knowledge": "node dev/build-knowledge-runtime.js && node dev/build-knowledge-pages.js",
    "generate:sitemap": "node scripts/generate-sitemap.js"
  }
}
