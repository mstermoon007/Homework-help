        "CATALOG": {
          "desc": "目录 / 版本 / 特性开关 / 科目工具",
          "files": [
            "shared/catalog-utils.js", "shared/module-catalog.js", "shared/version.js",
            "shared/feature-flags.js", "shared/subject-utils.js", "shared/difficulty.js",
            "shared/difficulty-static.js", "shared/generation-config.js"
          ]
        },
        "CSS": {
          "desc": "外围样式 tokens/components/pages/states/toolbar/subjects/base",
          "files": [
            "shared/base.css", "shared/tokens.css", "shared/components.css",
            "shared/pages.css", "shared/states.css", "shared/subjects.css", "shared/toolbar.css"
          ]
        }
      }
    }
  }
}