{
  "_doc": "Homework Help 权威四层架构清单（物理文件仍驻留 shared/，此清单为逻辑归属分类）。",
  "_boundary": "除 UI / 生成 / 知识库 三层以外，其余一律归入大服务层（信息传递 / 项目控制 / 外围样式 / 打印等外围控制）。",
  "_note": "物理不移动原因见 docs/ARCHITECTURE_LAYERS.md：common.js 按自身路径注入同目录子模块、预编译 bundle 内嵌 shared/ 模块id、sw.js 与 dev 门禁与测试均硬编 shared/ 路径，shared/ 为稳定模块根，切勿拆分。",
  "schema": {
    "layer": { "description": "string, alias: string, sub?: { groupName: { desc, files[] } }" }
  },

  "layers": {
    "UI": {
      "description": "负责显示：页面壳、交互、渲染呈现入口，不决策题目结构、不直接调用生成引擎算法。",
      "alias": "display",
      "files": [
        "index.html", "practice.html", "select.html", "faq.html", "contact.html",
        "math-types.html", "chinese-types.html", "english-types.html", "subject-types.html",
        "knowledge/*.html",
        "feedback/feedback.html", "feedback/feedback.css", "feedback/feedback.js",
        "sw.js"
      ]
    },

    "GENERATION": {
      "description": "题目生成核心引擎：题面/答案的算法生成、语义归一、渲染(HTML/SVG)输出。不含 UI 决策、不含服务控制。",
      "alias": "engine",
      "sub": {
        "CORE_ENGINE": {
          "desc": "共享入口：生成引擎 + 练习会话(核心引擎壳) + 预编译呈现 bundle",
          "files": [
            "shared/generation-engine.js", "shared/practice-session.js",
            "shared/presentation-engine.js", "shared/presentation-engine.bundle.js",
            "shared/strategy-engine.bundle.js"
          ]
        },
        "SEMANTIC": {
          "desc": "语义结构：Schema / semantic-question 归一与构造",
          "files": [
            "shared/semantic-question.js",
            "shared/generator/semantic-question-bridge.js",
            "shared/schemas/semantic-question.schema.js", "shared/schemas/knowledge-point.schema.js"
          ]
        },
        "GENERATOR": {
          "desc": "按知识点生成器：generator-registry/selector/contract/mode/retry/generators/core",
          "files": [
            "shared/generator/generator-contract.js", "shared/generator/generator-mode.js",
            "shared/generator/generator-registry.js", "shared/generator/generator-selector.js",
            "shared/generator/retry-loop.js", "shared/generator/migration-switch.js",
            "shared/generator/legacy-adapter.js",
            "shared/generator/graphic-renderer.js",
            "shared/generator/generators/arithmetic.js", "shared/generator/generators/complex.js",
            "shared/generator/generators/selection.js", "shared/generator/generators/index.js",
            "shared/generator/core/arithmetic-core.js", "shared/generator/core/kp-arithmetic-semantics.js",
            "shared/generator/core/kp-complex-semantics.js", "shared/generator/core/rng.js",
            "shared/generator-capability-registry.js", "shared/generator-registry.js"
          ]
        },
        "SERVICE_IFACE": {
          "desc": "生成服务接口：generation/orchestrator + adapters + services + api/dto",
          "files": [
            "shared/generation/api.js", "shared/generation/dto.js", "shared/generation/orchestrator.js",
            "shared/generation/adapters/capability-service.adapter.js",
            "shared/generation/adapters/knowledge-graph-service.adapter.js",
            "shared/generation/adapters/module-catalog-service.adapter.js",
            "shared/generation/adapters/plugin-loader-service.adapter.js",
            "shared/generation/services/capability-service.js",
            "shared/generation/services/knowledge-graph-service.js",
            "shared/generation/services/module-catalog-service.js",
            "shared/generation/services/plugin-loader-service.js"
          ]
        },
        "PRESENTATION": {
          "desc": "呈现层：HTML 渲染 + SVG 渲染器 + factory",
          "files": [
            "shared/presentation/html-renderer.js", "shared/presentation/legacy-svg-adapter.js",
            "shared/presentation/render-options.js", "shared/presentation/render-result.js",
            "shared/presentation/renderer.js", "shared/presentation/svg-registry.js",
            "shared/render.js", "shared/print.js"
          ]
        },
        "GRAPHIC_RENDER": {
          "desc": "图形描述渲染：graphic-renderer / svg-core",
          "files": [
            "shared/svg-core.js", "shared/svg-calculation.js", "shared/svg-chinese.js",
            "shared/svg-english.js", "shared/svg-geometry.js", "shared/svg-make-ten.js"
          ]
        },
        "PLUGINS": {
          "desc": "题型插件：按知识点出题实现（生成层能力，含竞赛判题子模块）",
          "files": ["plugins/**", "plugins/competition/**"]
        }
      }
    },

    "KNOWLEDGE": {
      "description": "知识点库基层数据：唯一数据核心、schema、规范映射（不生成题面、不参与 UI 决策）。pinyin-bank.js 为「根目录知识库数据例外」：属知识库数据但物理驻留根目录（8 处引用，迁移风险>收益），不物理迁移，详见 docs/ARCHITECTURE_LAYERS.md「知识库纯粹存放声明」。",
      "alias": "base-data",
      "files": [
        "shared/knowledge-bank.js", "shared/knowledge-point.js",
        "shared/knowledge-ontology.js", "shared/knowledge-ontology-normalizer.js",
        "shared/knowledge-ontology-validator.js", "shared/schemas/knowledge-point.schema.js",
        "shared/knowledge-cn.js", "shared/knowledge-en.js", "shared/knowledge-math.js",
        "shared/knowledge-error.js", "shared/knowledge-factual.js", "shared/knowledge-operation.js",
        "shared/hanzi-bank.js", "pinyin-bank.js",
        "shared/question-id.js", "shared/question-type-registry.js",
        "shared/ontology-error-map.js", "shared/ontology-factual-map.js", "shared/ontology-operation-map.js",
        "knowledge/*.html"
      ]
    },

    "SERVICE": {
