      "alias": "service-orchestration",
      "sub": {
        "ASSOCIATION": {
          "desc": "关联层(外围控制/编排)：唯一生成入口与批改分发",
          "files": ["shared/practice-bridge.js"]
        },
        "STRATEGY": {
          "desc": "策略(计划/难度/结构编排)；三维螺旋·自适应预留契约：adaptive/learnerProfile/adaptiveDelta 默认关，见 docs/ARCHITECTURE_LAYERS.md R5",
          "files": [
            "shared/strategy/adaptive-strategy.js", "shared/strategy/cognitive-strategy.js",
            "shared/strategy/comprehensive-strategy.js", "shared/strategy/constraint-builder.js",
            "shared/strategy/context-strategy.js", "shared/strategy/difficulty-strategy.js",
            "shared/strategy/number-range-strategy.js", "shared/strategy/question-plan.js",
            "shared/strategy/question-type-allocation.js", "shared/strategy/question-type-strategy.js",
            "shared/strategy/spiral-strategy.js", "shared/strategy/static-difficulty.js",
            "shared/strategy/strategy-engine.js", "shared/strategy/strategy-error.js",
            "shared/strategy/strategy-request.js", "shared/strategy/strategy-resolver.js",
            "shared/strategy/strategy-result.js", "shared/strategy/strategy-validator.js",
            "shared/strategy/structure-constraints.js", "shared/strategy/target-difficulty.js",
            "shared/strategy-config.js"
          ]
        },
        "VALIDATOR": {
          "desc": "校验器(质量/结构/图形/难度)",
          "files": [
            "shared/validator/answer-validator.js", "shared/validator/batch-validator.js",
            "shared/validator/difficulty-validator.js", "shared/validator/distractor-validator.js",
            "shared/validator/duplicate-validator.js", "shared/validator/graphic-validator.js",
            "shared/validator/kp-validator.js", "shared/validator/quality-scorer.js",
            "shared/validator/question-validator.js", "shared/validator/render-preflight.js",
            "shared/validator/structure-validator.js", "shared/validator/validation-pipeline.js"
          ]
        },
        "CAPABILITY": {
          "desc": "能力模型/矩阵/解析",
          "files": [
            "shared/capability-contract.js", "shared/capability-matrix.js",
            "shared/capability-model.js", "shared/capability-resolver.js",
            "shared/capability-scan-context.js"
          ]
        },
        "LEARNER": {
          "desc": "学习者模型/错题/结果收集",
          "files": [
            "shared/learner/error-model.js", "shared/learner/learner-model.js",
            "shared/learner/learner-storage.js", "shared/learner/practice-result.js",
            "shared/learner/result-collector.js"
          ]
        },
        "CORE_UTIL": {
          "desc": "共享基础(信息传递/注入入口)",
          "files": [
            "shared/common.js", "shared/core.js", "shared/check.js",
            "shared/plugin-loader.js", "shared/plugin-types.js"
          ]
        },
        "STATE_IO": {
          "desc": "UI 状态 / 存储 / 日志 / 指标",
          "files": [
            "shared/ui-state.js", "shared/storage.js", "shared/logger.js", "shared/metrics.js"
